NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Challenge GET; somente servidor. Não autentica o POST.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# HMAC-SHA256 do POST; somente servidor. Cadastrar como Secret na Vercel.
WHATSAPP_APP_SECRET=

# Opcional: scripts de homologação. Conexão administrativa do MESMO projeto.
# Preencher apenas localmente; nunca versionar credenciais. Porta 5432 (direta/sessão).
WHATSAPP_HOMOLOGATION_DATABASE_URL=
# Obrigatório para os scripts: CA oficial baixado do painel do Supabase.
# Caminho relativo à raiz do projeto ou absoluto. TLS sempre verificado.
SUPABASE_DATABASE_CA_PATH=./certs/supabase-ca.crt

# Provisionamento administrativo local: somente o número de TESTE autorizado.
WHATSAPP_TEST_WABA_ID=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_DISPLAY_PHONE_NUMBER=
